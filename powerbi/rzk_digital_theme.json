{
  "name": "RZK Digital Theme",
  "dataColors": [
    "#0C4165",
    "#50C0AE",
    "#125379",
    "#8197AC",
    "#063052",
    "#A8A7B1",
    "#3B82F6",
    "#10B981"
  ],
  "background": "#FFFFFF",
  "foreground": "#063052",
  "tableAccent": "#50C0AE",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#063052"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 95,
            "angle": 90,
            "preset": "Custom"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0C4165"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#8197AC"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}